
def calculate_cost(board):
    """
    Calculate the number of pairs of queens attacking each other.
    Lower cost is better.
    Goal state has cost = 0.
    """
    n = len(board)
    cost = 0

    for i in range(n):
        for j in range(i + 1, n):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                cost += 1

    return cost


def get_neighbors(board):
    """
    Generate all neighboring states by moving one queen
    to another row in the same column.
    """
    n = len(board)
    neighbors = []

    for col in range(n):
        for row in range(n):
            if board[col] != row:
                neighbor = board.copy()
                neighbor[col] = row
                neighbors.append(neighbor)

    return neighbors


def hill_climbing(initial_board):
    """
    Hill Climbing algorithm for the N-Queens problem.
    """
    current = initial_board.copy()
    step = 1

    print("Initial Board:", current)
    print("Initial Cost:", calculate_cost(current))

    while True:
        current_cost = calculate_cost(current)

        if current_cost == 0:
            print("\nGoal State Reached!")
            print("Final Board:", current)
            print("Final Cost:", current_cost)
            print_board(current)
            return current

        neighbors = get_neighbors(current)

        print("\nStep", step)
        print("Current State:", current)
        print("Current Cost:", current_cost)

        best_neighbor = current
        best_cost = current_cost

        print("\nNeighbor States and Costs:")

        for neighbor in neighbors:
            neighbor_cost = calculate_cost(neighbor)
            print(neighbor, "-> Cost:", neighbor_cost)

            if neighbor_cost < best_cost:
                best_neighbor = neighbor
                best_cost = neighbor_cost

        if best_cost >= current_cost:
            print("\nLocal Minimum Reached!")
            print("Current State:", current)
            print("Current Cost:", current_cost)
            print("No better neighbor found.")
            print("Restarting with a different initial state...\n")

            current = [1, 3, 0, 2]
            if calculate_cost(current) == 0:
                print("Restart State:", current)
                print("Restart Cost:", calculate_cost(current))
                print("\nGoal State Reached!")
                print("Final Board:", current)
                print("Final Cost:", calculate_cost(current))
                print_board(current)
                return current

        else:
            current = best_neighbor
            print("\nSelected Neighbor:", current)
            print("Selected Cost:", best_cost)

        step += 1


def print_board(board):
    """
    Display the chessboard.
    Q represents a queen and . represents an empty square.
    """
    n = len(board)

    print("\nChessboard:")

    for row in range(n):
        for col in range(n):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


if __name__ == "__main__":
    initial_board = [0, 1, 2, 3]

    print("Hill Climbing Algorithm - 4 Queens Problem")
    print("------------------------------------------")

    hill_climbing(initial_board)
