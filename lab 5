import random
import math

N = 8


def calculate_cost(board):
    """Count pairs of queens attacking each other."""
    cost = 0

    for i in range(N):
        for j in range(i + 1, N):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                cost += 1

    return cost


def get_neighbor(board):
    """Move one queen to a different row in the same column."""
    neighbor = board[:]

    col = random.randint(0, N - 1)
    new_row = random.randint(0, N - 1)

    while new_row == neighbor[col]:
        new_row = random.randint(0, N - 1)

    neighbor[col] = new_row
    return neighbor


def print_board(board):
    """Display the chessboard."""
    for row in range(N):
        for col in range(N):
            if board[col] == row:
                print(" Q ", end="")
            else:
                print(" . ", end="")
        print()


def simulated_annealing():
    """Solve the 8-Queens problem using simulated annealing."""
    max_restarts = 100
    max_iterations = 10000
    initial_temperature = 100.0
    cooling_rate = 0.995

    total_iterations = 0

    for restart in range(1, max_restarts + 1):
        current = [random.randint(0, N - 1) for _ in range(N)]
        current_cost = calculate_cost(current)
        temperature = initial_temperature

        print("Restart:", restart)
        print("Initial State:", current)
        print("Initial Cost:", current_cost)

        for iteration in range(max_iterations):
            total_iterations += 1

            if current_cost == 0:
                print("\nSolution found!")
                return current, total_iterations

            neighbor = get_neighbor(current)
            neighbor_cost = calculate_cost(neighbor)

            delta = neighbor_cost - current_cost

            # Accept better states.
            if delta < 0:
                current = neighbor
                current_cost = neighbor_cost

            # Sometimes accept worse states.
            elif random.random() < math.exp(-delta / temperature):
                current = neighbor
                current_cost = neighbor_cost

            # Cool the system.
            temperature *= cooling_rate

            # Stop this restart when the temperature is too low.
            if temperature < 0.001:
                break

        print("Best state in this restart:", current)
        print("Cost:", current_cost)
        print()

    return None, total_iterations


if __name__ == "__main__":
    print("8-Queens Problem Using Simulated Annealing")
    print("=" * 45)

    solution, iterations = simulated_annealing()

    print("\nTotal Iterations:", iterations)

    if solution is not None:
        print("Solution:", solution)
        print("Final Cost:", calculate_cost(solution))
        print("\nFinal Chessboard:")
        print_board(solution)
    else:
        print("Solution not found within the iteration limit.")
        print("Run the program again to try a different random search.")
